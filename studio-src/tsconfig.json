{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["ES2017", "DOM", "DOM.Iterable"],
        "moduleResolution": "node",
        "strict": true,
        "strictPropertyInitialization": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "jsx": "react",
        "skipLibCheck": true,
        "types": []
    },
    "include": ["./**/*"]
}
